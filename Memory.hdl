// Hack memory map: RAM[0..16383], Screen[16384..24575], Keyboard[24576].
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=isRAM);
    And(a=load, b=isRAM, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    Not(in=address[13], out=notA13);
    And(a=address[14], b=notA13, out=isScreen);
    And(a=load, b=isScreen, out=loadScreen);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    // All addresses at or above KBD read the keyboard; writes are ignored.
    And(a=address[14], b=address[13], out=isKeyboard);
    Keyboard(out=keyboardOut);
    Mux16(a=ramOut, b=screenOut, sel=address[14], out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyboardOut, sel=isKeyboard, out=out);
}
